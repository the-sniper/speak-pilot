# See README.md "How to run locally" for the full setup.
DATABASE_URL=postgres://USER@localhost:5432/speak_pilot
LLM_PROVIDER=mock          # mock | openai | anthropic
LLM_API_KEY=
LLM_MODEL=gpt-5
REPLAY=0                   # 1 = cache only, never call the API

# LLM_API_KEY can stay blank: .llm-cache/ is a committed replay corpus of real
# openai responses (see src/lib/llm/cache.ts). With REPLAY=1, no key set, AND
# LLM_PROVIDER=openai (NOT the "mock" default above -- the mock provider never
# reads or writes .llm-cache/ at all, see adapter.ts's activeCacheDir, so
# REPLAY=1 with LLM_PROVIDER=mock just serves mock fixtures, not the real
# corpus), every LLM call is served from that cache; a prompt not already in
# it throws CacheMissInReplayError instead of silently calling out. A key is
# only required to generate NEW cache entries (LLM_PROVIDER=openai/anthropic,
# REPLAY unset) or to run `npm run evals` against a real provider.
